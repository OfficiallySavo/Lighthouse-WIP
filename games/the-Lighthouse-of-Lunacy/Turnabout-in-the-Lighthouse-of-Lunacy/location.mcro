macro endlocation
# "variable is 4 {$timeline4}, 5 {$timeline5}, 6 {$timeline6}, 7 {$timeline7}, 8 {$timeline8}, 9 {$timeline9}, 10 {$timeline10}, 11 {$timeline11}, 12 {$timeline12}"
# "variablelocation is 4 {$t4location}, 5 {$t5location}, 6 {$t6location}, 7 {$t7location}, 8 {$t8location}, 9 {$t9location}, 10 {$t10location}, 11 {$t11location}, 12 {$t12location}"
set timelinebutton1 inactive
set timelinebutton2 inactive
set timelinebutton3 inactive
set timelinebutton4 inactive
set timelinebutton5 inactive
set timelinebutton6 inactive
set timelinebutton7 inactive
set timelinebutton8 inactive
set timelinebutton9 inactive
set timelinebutton10 inactive
set timelinebutton11 inactive
set timelinebutton12 inactive
setflag endinglocation
setflag scriptreset
endmacro

